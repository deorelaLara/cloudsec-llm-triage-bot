aws_region   = "ap-southeast-2"
project_name = "cloudsec-llm-triage-bot"
environment  = "dev"

vpc_cidr             = "10.40.0.0/16"
availability_zones   = ["ap-southeast-2a", "ap-southeast-2b", "ap-southeast-2c"]
public_subnet_cidrs  = ["10.40.0.0/24", "10.40.1.0/24", "10.40.2.0/24"]
private_subnet_cidrs = ["10.40.10.0/24", "10.40.11.0/24", "10.40.12.0/24"]

llm_provider     = "bedrock"
bedrock_model_id = "au.anthropic.claude-sonnet-4-6"

confluence_space_key      = "SECOPS"
confluence_parent_page_id = ""

# Path to the manually-built Lambda ZIP (see README "Empaquetado manual de la Lambda").
lambda_package_path = "../cloudsec-llm-triage-bot-lambda.zip"
