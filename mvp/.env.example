LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Para cambiar a Bedrock: pon LLM_PROVIDER=bedrock y rellena lo siguiente.
# Requiere credenciales AWS locales, permiso bedrock:InvokeModel y acceso al
# modelo habilitado en consola para esa region.
# AWS_REGION=ap-southeast-2
# AWS_PROFILE=
# BEDROCK_MODEL_ID=au.anthropic.claude-sonnet-4-6
LLM_SELF_CONSISTENCY_SAMPLES=1
SUPPRESSION_ALLOWLIST=Recon:EC2/PortProbeUnprotectedPort,Software and Configuration Checks/Package Vulnerability
MCP_URL=http://127.0.0.1:8001/
LOG_LEVEL=INFO
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mvp-cloudsec-triage
